{
  "name": "ifive-bt-assessment",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "dotenvx run -f .env -- prisma generate",
    "db:push": "dotenvx run -f .env -- prisma db push",
    "db:migrate": "dotenvx run -f .env -- prisma migrate dev",
    "db:migrate:reset": "dotenvx run -f .env -- prisma migrate reset",
    "db:studio": "dotenvx run -f .env -- prisma studio",
    "db:seed": "dotenvx run -f .env -- prisma db seed",
    "depcheck": "depcheck --ignores=\"\"",
    "dev": "vite dev",
    "env:encrypt": "dotenvx encrypt",
    "env:decrypt": "dotenvx decrypt",
    "env:set": "dotenvx set",
    "env:get": "dotenvx get --format eval",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "bun build && bun start",
    "start": "dotenvx run -- node dist/serve-node.js",
    "typecheck": "tsgo --noemit"
  },
  "simple-git-hooks": {
    "pre-commit": "bun install --ignore-scripts --offline && bunx biome ci . && bun run typecheck"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "@tanstack/react-start": "^1.112.3",
    "@tanstack/react-start-client": "^1.112.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-core": "^1.112.0",
    "@tanstack/start-client": "^1.111.9",
    "better-auth": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.19",
    "hono-pino": "^0.7.0",
    "jsesc": "^3.1.0",
    "lucide-react": "^0.563.0",
    "nanoid": "^5.1.2",
    "next-themes": "^0.4.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scan": "^0.2.8",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tiny-warning": "^1.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.34.0",
    "@hono/node-server": "^1.13.7",
    "@hono/vite-dev-server": "^0.18.1",
    "@t3-oss/env-core": "^0.11.1",
    "@tanstack/router-devtools": "^1.112.6",
    "@tanstack/router-plugin": "^1.112.3",
    "@types/jsesc": "^3.0.3",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript/native-preview": "^7.0.0-dev.20260129.1",
    "@vitejs/plugin-react": "^4.3.4",
    "depcheck": "^1.4.7",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.6",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-sri3": "^1.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
